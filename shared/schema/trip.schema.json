{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip",
  "title": "Trip (trips/{tripId})",
  "type": "object",
  "required": [
    "ownerUid",
    "travelerName",
    "city",
    "country",
    "platform",
    "createdAtMillis"
  ],
  "properties": {
    "ownerUid": {
      "type": "string"
    },
    "travelerName": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "packId": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "enum": [
        "android",
        "ios",
        "web"
      ]
    },
    "createdAtMillis": {
      "type": "number"
    }
  }
}
